{
  "name": "brain-graph",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "build:static": "tsc -b && vite build --mode static",
    "export:static": "node server/export-static.ts",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "graph:dump": "node server/dump.ts",
    "graph:homes": "node server/homes.ts",
    "prepare": "npm run build",
    "start": "node bin/brain-graph.mjs",
    "test": "node --test test/vault.test.ts test/activity-hook.test.mjs test/trails.test.ts test/tolaria.test.ts test/cli.test.mjs"
  },
  "dependencies": {
    "@sigma/export-image": "^4.0.0",
    "chokidar": "^6.0.0",
    "dompurify": "^3.4.17",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-types": "^0.24.8",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sigma": "^4.0.3",
    "sirv": "^3.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "description": "Interactive graph view of a Markdown note vault (Tolaria-style frontmatter types and wikilink relationships), coloured and grouped by the project or responsibility each note belongs to.",
  "license": "MIT",
  "bin": {
    "brain-graph": "bin/brain-graph.mjs"
  },
  "files": [
    "bin",
    "hooks",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mfoll/brain-graph.git"
  },
  "packageManager": "pnpm@12.3.4"
}
